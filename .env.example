# ──────────────────────────────────────────────
# Hermes Chat UI — Environment Configuration
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# === Docker Ports ===
BACKEND_PORT=8642          # Hermes Agent API (optional host exposure)
PROXY_PORT=8643            # Hermes Chat UI / BFF
DASHBOARD_PORT=9119        # Official Hermes dashboard

# === Dashboard Auth (official Hermes environment names) ===
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
# Generate once with `openssl rand -hex 32`; do not change it after deploy.
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
# Password provider used by the UI BFF for canonical proactive-message import.
HERMES_DASHBOARD_AUTH_PROVIDER=basic

# === API Server (Hermes Agent built-in) ===
API_SERVER_ENABLED=true
API_SERVER_KEY=changeme    # REQUIRED — choose a strong random value
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642
API_SERVER_CORS_ORIGINS=
API_SERVER_MODEL_NAME=     # Default model name (e.g., hermes-3-llama-3.1-8b)

# === Home Assistant Integration (Optional) ===
HASS_URL=                  # e.g., http://homeassistant.local:8123
HASS_TOKEN=                # Long-lived access token

# === GitHub Integration (Optional) ===
GITHUB_TOKEN=              # Personal access token for GitHub tools

# === Push Notifications (Auto-configured on first boot, override only if needed) ===
# Includes faster-whisper for `stt.provider: local`.
# HERMES_STT_PACKAGE=hermes-agent[voice]==0.19.0
# VAPID_KEYS_FILE=/app/data/vapid_keys.json
# VAPID_SUBJECT=mailto:admin@hermes.local
# REQUIRED for proactive messages. Generate a distinct value with:
# openssl rand -hex 32
HERMES_PUSH_API_KEY=
