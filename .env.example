# Copy to .env. For an existing Hermes, use its API_SERVER_KEY here.
# For a new Hermes, generate a key with: openssl rand -hex 32
API_SERVER_KEY=

# URL reachable FROM the UI container, not from your browser.
# On the shared Docker network, use the Hermes service/container name.
HERMES_API_URL=http://hermes-agent:8642
HERMES_NETWORK=hermes-internal
HERMES_UI_IMAGE=ghcr.io/lukegskw/hermes-chat-ui:latest

# Local access by default; see docs/mobile.md for HTTPS access from your phone.
UI_BIND_ADDRESS=127.0.0.1
PROXY_PORT=8643

# Optional, NEW Hermes installation only (docker-compose.hermes-agent.yml).
# Existing users should keep their own Hermes container and volumes.
HERMES_DATA_DIR=./hermes-data
# HERMES_IMAGE=nousresearch/hermes-agent:<tested-tag-or-digest>
BACKEND_PORT=8642
DASHBOARD_PORT=9119
HERMES_DASHBOARD=0

# Optional config.yaml overlay; see docs/installation.md.
# HERMES_CONFIG_FILE=/absolute/path/to/hermes/config.yaml

# Chat completion notifications work without these settings.
# VAPID keys and push subscriptions are generated/stored in the UI data volume.
VAPID_SUBJECT=mailto:push@example.com

# Optional proactive automation and authenticated official dashboard.
# Generate dedicated keys with: openssl rand -hex 32
HERMES_PUSH_API_KEY=
HERMES_DASHBOARD_URL=
HERMES_DASHBOARD_AUTH_PROVIDER=basic
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
